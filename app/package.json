{
	"name": "gradient-app",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && bash scripts/check-closed-sets.sh",
		"lint:data": "bash scripts/check-closed-sets.sh",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"worker": "tsx --tsconfig tsconfig.worker.json src/worker/transcode.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/pg": "^8.23.1",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.28.0",
		"svelte-check": "^4.1.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.70.0",
		"vite": "^6.2.0",
		"vitest": "^3.1.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@aws-sdk/s3-request-presigner": "^3.1146.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@types/leaflet": "^1.9.16",
		"leaflet": "^1.9.4",
		"pg": "^8.23.0"
	}
}
