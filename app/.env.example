# Copy to app/.env and adjust. Port 5434 maps to the docker-compose db service.
DATABASE_URL=postgresql://user:password@localhost:5434/gradientrip

# Map tile API keys (optional — CARTO/Stadia styles work keyless on localhost)
VITE_CARTO_API_KEY=
VITE_STADIA_API_KEY=

# Google sign-in (required for Friends). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, Web):
#   Authorized redirect URI: http://localhost:5173/api/auth/google/callback
#   (plus your production origin + /api/auth/google/callback when deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
